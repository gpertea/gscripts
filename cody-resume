#!/usr/bin/env python3
"""Apply cody defaults to newly selected threads through a local client proxy."""
import asyncio
import json
from pathlib import Path
import secrets
import signal
import struct
import sys
import tempfile


async def header(reader):
    return await asyncio.wait_for(reader.readuntil(b'\r\n\r\n'), 10)


async def frame(reader):
    first, second = await reader.readexactly(2)
    size = second & 127
    prefix = bytes((first, second))
    if size in (126, 127):
        extended = await reader.readexactly(2 if size == 126 else 8)
        prefix += extended
        size = struct.unpack('!H' if size == 126 else '!Q', extended)[0]
    mask = await reader.readexactly(4) if second & 128 else b''
    body = await reader.readexactly(size)
    raw = prefix + mask + body
    if mask:
        body = bytes(value ^ mask[index % 4] for index, value in enumerate(body))
    return first, body, raw


def encode(message, masked=False):
    body = json.dumps(message, separators=(',', ':')).encode()
    size = len(body)
    prefix = bytes((0x81, (0x80 if masked else 0) | min(size, 126)))
    if size >= 126:
        prefix = bytes((0x81, (0x80 if masked else 0) | (126 if size < 65536 else 127)))
        prefix += struct.pack('!H' if size < 65536 else '!Q', size)
    if not masked:
        return prefix + body
    mask = secrets.token_bytes(4)
    return prefix + mask + bytes(value ^ mask[index % 4] for index, value in enumerate(body))


class ResumeProxy:
    def __init__(self, endpoint):
        self.path = endpoint.removeprefix('unix://')
        self.restored = set()
        self.tasks = set()
        self.timeout = 20

    async def connect(self, reader, writer):
        task = asyncio.current_task()
        self.tasks.add(task)
        upstream = None
        pumps = []
        updates, checks, deadlines = {}, {}, {}
        try:
            server_reader, upstream = await asyncio.open_unix_connection(self.path)
            upstream.write(await header(reader))
            await upstream.drain()
            reply = await header(server_reader)
            if not reply.startswith(b'HTTP/1.1 101 '):
                raise RuntimeError('app-server refused WebSocket connection')
            writer.write(reply)
            await writer.drain()
            resumes = {}
            token = 'cody-' + secrets.token_hex(16)

            async def pump(source, destination, from_server):
                parts, raws = [], []
                opcode = None
                while True:
                    # bound internal RPCs without imposing an idle-client timeout
                    pending = bool(updates or checks) if from_server else False
                    timeout = max(0, min(deadlines.values()) - asyncio.get_running_loop().time()) if pending else None
                    first, body, raw = await asyncio.wait_for(frame(source), timeout)
                    current = first & 15
                    if current >= 8:
                        if current == 8 and (updates or checks):
                            raise RuntimeError('connection closed during permission restoration')
                        destination.write(raw)
                        await destination.drain()
                        if current == 8:
                            return
                        continue
                    if current:
                        opcode = current
                    parts.append(body)
                    raws.append(raw)
                    if not first & 128:
                        continue
                    message = json.loads(b''.join(parts)) if opcode == 1 else None
                    outgoing = b''.join(raws)
                    parts, raws = [], []
                    if isinstance(message, dict):
                        request_id = message.get('id')
                        if not from_server and message.get('method') in ('thread/start', 'thread/resume', 'thread/fork'):
                            method = message['method']
                            params = message.setdefault('params', {})
                            verify_creation = method == 'thread/start' or (
                                method == 'thread/fork' and params.get('ephemeral', False))
                            resumes[request_id] = verify_creation
                            # ephemeral forks have no rollout; verify their creation response
                            # prediction forks only allow inherited configuration
                            if verify_creation and not params.get('experimentalPredictionMode', False):
                                params.pop('sandbox', None)
                                params.update(permissions=':danger-full-access',
                                              approvalPolicy='never', approvalsReviewer='user')
                                outgoing = encode(message, True)
                        elif from_server and 'method' not in message:
                            if request_id in resumes:
                                verify_creation = resumes.pop(request_id)
                                if verify_creation and 'result' in message:
                                    if self.full_access(message['result']):
                                        self.restored.add(message['result']['thread']['id'])
                                    else:
                                        outgoing = encode(self.failure(message, 'server did not confirm Full Access'))
                                elif 'result' in message and message['result']['thread']['id'] not in self.restored:
                                    # each selected thread receives the default once per client lifetime
                                    thread_id = message['result']['thread']['id']
                                    update_id = token + '-update-' + secrets.token_hex(16)
                                    updates[update_id] = message
                                    deadlines[update_id] = asyncio.get_running_loop().time() + self.timeout
                                    upstream.write(encode(dict(id=update_id, method='thread/settings/update',
                                        params=dict(threadId=thread_id, permissions=':danger-full-access',
                                                    approvalPolicy='never', approvalsReviewer='user')), True))
                                    await upstream.drain()
                                    continue
                            elif request_id in updates:
                                original = updates.pop(request_id)
                                deadline = deadlines.pop(request_id)
                                if 'error' in message:
                                    outgoing = encode(self.failure(original, message['error']['message']))
                                else:
                                    # read back effective settings, including warm-thread behavior
                                    check_id = token + '-check-' + secrets.token_hex(16)
                                    checks[check_id] = original
                                    deadlines[check_id] = deadline
                                    upstream.write(encode(dict(id=check_id, method='thread/resume',
                                        params=dict(threadId=original['result']['thread']['id'], excludeTurns=True)), True))
                                    await upstream.drain()
                                    continue
                            elif request_id in checks:
                                original = checks.pop(request_id)
                                deadlines.pop(request_id)
                                result = message.get('result', {})
                                if 'error' in message:
                                    outgoing = encode(self.failure(original, message['error']['message']))
                                elif not self.full_access(result):
                                    outgoing = encode(self.failure(original, 'server did not confirm Full Access'))
                                else:
                                    self.restored.add(original['result']['thread']['id'])
                                    # preserve history/cwd/model; expose verified permission fields to the TUI
                                    for key in ('approvalPolicy', 'approvalsReviewer', 'sandbox', 'activePermissionProfile'):
                                        original['result'][key] = result[key]
                                    outgoing = encode(original)
                    destination.write(outgoing)
                    await destination.drain()

            pumps = [asyncio.create_task(pump(reader, upstream, False)),
                     asyncio.create_task(pump(server_reader, writer, True))]
            done, _ = await asyncio.wait(pumps, return_when=asyncio.FIRST_COMPLETED)
            for finished in done:
                finished.result()
        except (OSError, RuntimeError, ValueError, asyncio.IncompleteReadError, asyncio.TimeoutError) as error:
            if updates or checks:
                reason = str(error) or 'permission restoration timed out or disconnected'
                try:
                    for original in [*updates.values(), *checks.values()]:
                        writer.write(encode(self.failure(original, reason)))
                    await writer.drain()
                except OSError:
                    pass
            if not isinstance(error, asyncio.IncompleteReadError):
                print(f'cody-resume: {str(error) or "permission restoration timed out"}', file=sys.stderr)
        finally:
            for running in pumps:
                running.cancel()
            for stream in (writer, upstream):
                if stream:
                    stream.close()
            await asyncio.gather(*pumps, return_exceptions=True)
            for stream in (writer, upstream):
                if stream:
                    try:
                        await stream.wait_closed()
                    except OSError:
                        pass
            self.tasks.discard(task)

    @staticmethod
    def full_access(result):
        return (result.get('approvalPolicy') == 'never'
                and (result.get('sandbox') or {}).get('type') == 'dangerFullAccess'
                and (result.get('activePermissionProfile') or {}).get('id') == ':danger-full-access'
                and result.get('approvalsReviewer') == 'user')

    @staticmethod
    def failure(original, reason):
        return dict(id=original['id'], error=dict(code=-32000,
                    message='cody: cannot restore Full Access: ' + reason))


async def run(codex, endpoint, arguments):
    if not endpoint.startswith('unix://'):
        raise RuntimeError('a local Unix app-server endpoint is required')
    proxy = ResumeProxy(endpoint)
    # the private socket exists only for this client; the display server is unchanged
    with tempfile.TemporaryDirectory(prefix='cody-resume-', dir='/tmp') as directory:
        path = str(Path(directory) / 'client.sock')
        server = await asyncio.start_unix_server(proxy.connect, path)
        async with server:
            child = await asyncio.create_subprocess_exec(codex, '--remote', 'unix://' + path, *arguments)
            loop = asyncio.get_running_loop()
            for signum in (signal.SIGTERM, signal.SIGHUP):
                loop.add_signal_handler(signum, lambda sig=signum: child.send_signal(sig) if child.returncode is None else None)
            try:
                result = await child.wait()
            finally:
                for task in list(proxy.tasks):
                    task.cancel()
                await asyncio.gather(*proxy.tasks, return_exceptions=True)
            return result if result >= 0 else 128 - result


if __name__ == '__main__':
    # terminal Ctrl-C belongs to Codex, which shares this process group
    signal.signal(signal.SIGINT, lambda *_: None)
    try:
        sys.exit(asyncio.run(run(sys.argv[1], sys.argv[2], sys.argv[3:])))
    except (OSError, RuntimeError) as error:
        print(f'cody-resume: {error}', file=sys.stderr)
        sys.exit(1)
