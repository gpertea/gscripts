#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf '%s\n' \
    "Usage: vnc-session-view [--direct] [--force-restart] SSH_HOST[:DISPLAY|:NAME]" \
    "       vnc-session-view [--tunnel] SSH_HOST[:DISPLAY|:NAME]" \
    "       vnc-session-view --status SSH_HOST[:DISPLAY|:NAME]" \
    "       vnc-session-view --stop [--force] SSH_HOST[:DISPLAY|:NAME]" \
    "Default transport: --tunnel; default target: display :1" \
    "Linux allocates local ports automatically; VNC_SESSION_LOCAL_DISPLAY requests a fixed local display."
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

action="start"
transport="tunnel"
force_restart="false"
force_stop="false"
while [[ "${1:-}" == --* ]]; do
  case "$1" in
    --direct|--tunnel) transport="${1#--}" ;;
    --force-restart) force_restart="true" ;;
    --force) force_stop="true" ;;
    --status|--stop) action="${1#--}" ;;
    --help|-h) usage; exit 0 ;;
    *) die "unknown option: $1" ;;
  esac
  shift
done
[[ "$action" == "start" || "$force_restart" == "false" ]] || die "--force-restart is only valid when opening a viewer"
[[ "$transport" == "direct" || "$force_restart" == "false" ]] || die "--force-restart is only valid with --direct"
[[ "$action" == "stop" || "$force_stop" == "false" ]] || die "--force is only valid with --stop"

[[ $# -eq 1 ]] || { usage >&2; exit 1; }
target="$1"
if [[ "$target" == *:* ]]; then
  remote_host="${target%%:*}"
  requested_target="${target#*:}"
else
  remote_host="$target"
  requested_target="1"
fi
[[ -n "$remote_host" && -n "$requested_target" ]] || die "target must look like srv16, srv16:2, or srv16:browser"

if [[ "$requested_target" =~ ^[1-9][0-9]*$ ]]; then
  session=":$requested_target"
else
  session="$requested_target"
fi
readonly session remote_host
readonly password_file="${VNC_SESSION_PASSWORD_FILE:-${HOME}/.vnc/passwd}"
readonly viewer="${VNC_VIEWER:-vncviewer}"
readonly client_os="$(uname -s)"

if [[ "$session" == :* ]]; then
  [[ "$session" =~ ^:[1-9][0-9]*$ ]] || die "display must look like :2"
else
  [[ "$session" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die "invalid session name"
fi

remote_vnc() {
  ssh -n "$remote_host" '"$HOME/bin/vnc-session"' "$@"
}

ensure_remote_target() {
  local display mapped_name="" remote_help=""

  remote_help="$(remote_vnc --help 2>&1)" || {
    printf '%s\n' "$remote_help" >&2
    die "could not inspect vnc-session on $remote_host"
  }
  if grep -Fq -- '--direct|--tunnel' <<< "$remote_help"; then
    if [[ "$transport" == "direct" ]]; then
      if [[ "$force_restart" == "true" ]]; then
        remote_vnc ensure --direct --force-restart "$session"
      else
        remote_vnc ensure --direct "$session"
      fi
    else
      ## tunneling works with either loopback or LAN listener policy
      remote_vnc ensure "$session"
    fi
    return
  fi

  [[ "$transport" != "direct" ]] || die "remote vnc-session must be updated for --direct"

  ## support hosts that have not yet pulled the exact-display ensure command
  if [[ "$session" != :* ]]; then
    remote_vnc start "$session" >&2
    remote_vnc display "$session"
    return
  fi

  display="${session#:}"
  mapped_name="$(
    remote_vnc list |
      awk -v target=":${display}" '$2 == target && $1 != "-" {print $1; exit}'
  )"
  if [[ -n "$mapped_name" ]]; then
    remote_vnc start "$mapped_name" >&2
  elif ! remote_vnc status "$session" >/dev/null 2>&1; then
    remote_vnc start "display-${display}" "$session" >&2
  fi
  printf '%s\n' "$display"
}

stop_remote_target() {
  local remote_help=""

  remote_help="$(remote_vnc --help 2>&1)" || {
    printf '%s\n' "$remote_help" >&2
    die "could not inspect vnc-session on $remote_host"
  }
  grep -Fq 'stop [--force] NAME|:DISPLAY' <<< "$remote_help" || \
    die "remote vnc-session on $remote_host must be updated for guarded desktop stops"
  if [[ "$force_stop" == "true" ]]; then
    remote_vnc stop --force "$session"
  else
    remote_vnc stop "$session"
  fi
}

init_tunnel_state() {
  control_dir="${XDG_RUNTIME_DIR:-/tmp}/vnc-session-${UID}"
  control_path="${control_dir}/ssh-display-${remote_display}-%C"
  ## Preserve the existing non-Linux path; Linux recovery uses /proc.
  [[ "$client_os" == Linux ]] || return 0
  mkdir -p "$control_dir"
  chmod 700 "$control_dir"
  control_socket="$(ssh -G -S "$control_path" "$remote_host" 2>/dev/null |
    sed -n 's/^controlpath //p')" || die "could not resolve SSH control path"
  [[ "$control_socket" == "${control_dir}/ssh-display-${remote_display}-"* &&
     "$control_socket" != *%* ]] || die "invalid resolved SSH control path"
  control_pid_file="${control_socket}.pid"
  exec 9>"${control_socket}.lock"
  flock -w 15 9 || die "another launch is updating this VNC tunnel"
}

tunnel_control() {
  control_output="$(timeout 5 ssh -n -S "$control_path" -O "$1" "$remote_host" 2>&1)"
}

read_tunnel_process() {
  local pid="$1" index destination resolved executable
  local -a args
  [[ "$pid" =~ ^[1-9][0-9]*$ && -r "/proc/$pid/cmdline" ]] || return 1
  executable="$(readlink "/proc/$pid/exe")" || return 1
  [[ "$executable" == */ssh || "$executable" == */ssh\ \(deleted\) ]] || return 1
  mapfile -d '' -t args < "/proc/$pid/cmdline"
  local has_master=false has_socket=false port=""
  for ((index = 0; index < ${#args[@]} - 1; index++)); do
    case "${args[index]}" in
      -M) has_master=true ;;
      -S) [[ "${args[index+1]}" != "$control_path" ]] || has_socket=true ;;
      -L)
        if [[ "${args[index+1]}" =~ ^127\.0\.0\.1:([1-9][0-9]*):127\.0\.0\.1:${remote_port}$ ]]; then
          port="${BASH_REMATCH[1]}"
        fi ;;
    esac
  done
  [[ "$has_master" == true && "$has_socket" == true && -n "$port" ]] || return 1
  (( port <= 65535 )) || return 1
  ## Resolve the master's original alias: two aliases for one endpoint can
  ## share a tunnel, but a reused PID for another host must never be killed.
  destination="${args[${#args[@]}-1]}"
  resolved="$(ssh -G -S "$control_path" "$destination" 2>/dev/null |
    sed -n 's/^controlpath //p')" || return 1
  [[ "$resolved" == "$control_socket" ]] || return 1
  local_port="$port"
}

stop_tunnel() {
  local pid attempt
  if [[ "$client_os" != Linux ]]; then
    ssh -n -S "$control_path" -O exit "$remote_host" >/dev/null 2>&1 || true
    return
  fi
  if ! tunnel_control exit && [[ -r "$control_pid_file" ]]; then
    pid="$(<"$control_pid_file")"
    if read_tunnel_process "$pid"; then
      kill "$pid" 2>/dev/null || true
      for ((attempt = 0; attempt < 20; attempt++)); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.1
      done
      if read_tunnel_process "$pid"; then
        kill -9 "$pid" 2>/dev/null || true
      fi
    fi
  fi
  rm -f -- "$control_pid_file"
  [[ ! -S "$control_socket" ]] || rm -f -- "$control_socket"
}

remember_tunnel() {
  local pid
  pid="$(sed -n 's/^Master running (pid=\([0-9][0-9]*\)).*/\1/p' <<< "$control_output")"
  read_tunnel_process "$pid" || die "could not identify the existing VNC tunnel's local port"
  printf '%s\n' "$pid" > "$control_pid_file"
}

allocate_tunnel_port() {
  local_port="$(perl -MIO::Socket::INET -e '
    my $s = IO::Socket::INET->new(LocalAddr => "127.0.0.1", LocalPort => 0,
                                 Listen => 1, Proto => "tcp") or die "$!\n";
    print $s->sockport, "\n";
  ')" || die "could not allocate a local VNC port"
  [[ "$local_port" =~ ^[1-9][0-9]*$ ]] && (( local_port <= 65535 )) || \
    die "invalid allocated VNC port: $local_port"
}

ensure_tunnel() {
  local attempt output output_file
  if tunnel_control check; then
    remember_tunnel
    if [[ -n "$requested_port" && "$local_port" != "$requested_port" ]]; then
      die "existing tunnel uses port $local_port; unset VNC_SESSION_LOCAL_DISPLAY to reuse it"
    fi
    return
  fi
  stop_tunnel
  for ((attempt = 0; attempt < 5; attempt++)); do
    if [[ -n "$requested_port" ]]; then
      local_port="$requested_port"
    else
      allocate_tunnel_port
    fi
    output_file="$(mktemp "${control_dir}/.start.XXXXXX")"
    if LC_ALL=C ssh -fNT -M -S "$control_path" \
        -o ExitOnForwardFailure=yes -o ConnectTimeout=10 \
        -o ServerAliveInterval=15 -o ServerAliveCountMax=2 -o TCPKeepAlive=yes \
        -L "127.0.0.1:${local_port}:127.0.0.1:${remote_port}" \
        "$remote_host" 9>&- >"$output_file" 2>&1; then
      output="$(<"$output_file")"
      rm -f -- "$output_file"
      [[ -z "$output" ]] || printf '%s\n' "$output" >&2
      tunnel_control check || die "new SSH VNC tunnel did not become responsive: $control_output"
      remember_tunnel
      return
    fi
    output="$(<"$output_file")"
    rm -f -- "$output_file"
    if [[ -n "$requested_port" ]] ||
       ! grep -Eq '^bind .*: (Address already in use|Permission denied)' <<< "$output"; then
      printf '%s\n' "$output" >&2
      die "could not create VNC tunnel on local port $local_port"
    fi
  done
  printf '%s\n' "$output" >&2
  die "could not bind an automatically allocated VNC port after five attempts"
}

if [[ "$action" == "status" ]]; then
  remote_vnc status "$session"
  exit
fi

if [[ "$action" == "stop" ]]; then
  stop_display="$(remote_vnc display "$session")"
  [[ "$stop_display" =~ ^[1-9][0-9]*$ ]] || die "invalid remote display: $stop_display"
  remote_display="$stop_display"
  remote_port=$((5900 + remote_display))
  init_tunnel_state
  stop_remote_target
  stop_tunnel
  exit 0
fi

[[ -r "$password_file" ]] || die "VNC password file is missing: $password_file"
command -v "$viewer" >/dev/null 2>&1 || die "VNC viewer is not installed: $viewer"

## ensure the requested listener mode before choosing the data transport
remote_display="$(ensure_remote_target)"
[[ "$remote_display" =~ ^[1-9][0-9]*$ ]] || die "invalid remote display: $remote_display"
remote_vnc status ":${remote_display}" >/dev/null

## aliases for one remote display share one optional tunnel
readonly remote_port=$((5900 + remote_display))
(( remote_port <= 65535 )) || die "VNC display is too large"
init_tunnel_state
if [[ "$transport" == "direct" ]]; then
  ## close a stale tunnel because this viewer will use the direct data plane
  stop_tunnel
  direct_host="${VNC_DIRECT_HOST:-$(ssh -G "$remote_host" 2>/dev/null | awk '$1 == "hostname" {print $2; exit}')}"
  [[ -n "$direct_host" ]] || die "could not resolve direct VNC host for $remote_host"
  printf 'Opening direct VNC %s:%s after SSH session initiation\n' "$direct_host" "$remote_display"
  if [[ "$client_os" == Linux ]]; then
    flock -u 9
    exec 9>&-
  fi
  exec "$viewer" "passwd=${password_file}" "${direct_host}:${remote_display}"
fi

if [[ "$client_os" != Linux ]]; then
  ## Non-Linux clients retain their existing display-based forwarding policy.
  local_display="${VNC_SESSION_LOCAL_DISPLAY:-$((remote_display + 10))}"
  [[ "$local_display" =~ ^[1-9][0-9]*$ ]] || die "invalid local display"
  local_port=$((5900 + local_display))
  (( local_port <= 65535 )) || die "VNC display is too large"
  mkdir -p "$control_dir"
  chmod 700 "$control_dir"
  if ! ssh -n -S "$control_path" -O check "$remote_host" >/dev/null 2>&1; then
    ssh -fNT -M -S "$control_path" -o ExitOnForwardFailure=yes \
      -L "127.0.0.1:${local_port}:127.0.0.1:${remote_port}" "$remote_host"
  fi
  exec "$viewer" "passwd=${password_file}" "localhost:${local_display}"
fi

requested_port=""
if [[ -n "${VNC_SESSION_LOCAL_DISPLAY:-}" ]]; then
  [[ "$VNC_SESSION_LOCAL_DISPLAY" =~ ^[1-9][0-9]{0,4}$ ]] &&
    (( VNC_SESSION_LOCAL_DISPLAY <= 59635 )) || die "invalid local display"
  requested_port=$((5900 + VNC_SESSION_LOCAL_DISPLAY))
fi
ensure_tunnel
printf 'Opening %s %s (:%s) on local port %s\n' \
  "$remote_host" "$session" "$remote_display" "$local_port"
flock -u 9
exec 9>&-
## Double colon is an explicit TCP port, not a VNC display number.
exec "$viewer" "passwd=${password_file}" "localhost::${local_port}"
