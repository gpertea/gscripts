#!/usr/bin/env bash
set -euo pipefail

## Windows/MSYS2 client; preserve the established TigerVNC installation
readonly VNC_VIEWER="${VNC_VIEWER:-/c/util/vnc/tigervncviewer.exe}"
readonly VNC_PASSWORD='C:\util\vnc\vnc-gxlin-passwd'

usage() {
  printf '%s\n' \
    "Usage:" \
    "  $(basename "$0") HOST [GEOMETRY]" \
    "  $(basename "$0") HOST --session NAME [GEOMETRY]" \
    "  $(basename "$0") HOST --status NAME" \
    "  $(basename "$0") HOST --stop [--force] NAME" \
    "Set VNC_LOCAL_PORT to override the local tunnel port for a named session."
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

[[ $# -ge 1 ]] || { usage >&2; exit 2; }
if [[ "$1" == "--help" || "$1" == "-h" ]]; then
  usage
  exit 0
fi
ssh_host="$1"
vnc_host="${VNC_HOST:-${ssh_host#*@}}"
shift

action="legacy"
force_stop="false"
session=""
geometry="1820x960"
case "${1:-}" in
  --session)
    [[ $# -ge 2 && $# -le 3 ]] || { usage >&2; exit 2; }
    action="session"
    session="$2"
    geometry="${3:-$geometry}"
    ;;
  --status)
    [[ $# -eq 2 ]] || { usage >&2; exit 2; }
    action="${1#--}"
    session="$2"
    ;;
  --stop)
    [[ $# -ge 2 && $# -le 3 ]] || { usage >&2; exit 2; }
    action="stop"
    if [[ "${2:-}" == "--force" ]]; then
      [[ $# -eq 3 ]] || { usage >&2; exit 2; }
      force_stop="true"
      session="$3"
    else
      [[ $# -eq 2 ]] || { usage >&2; exit 2; }
      session="$2"
    fi
    ;;
  --help|-h)
    usage
    exit 0
    ;;
  "")
    ;;
  *)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    geometry="$1"
    ;;
esac

[[ "$geometry" =~ ^[1-9][0-9]*x[1-9][0-9]*$ ]] || die "invalid geometry: $geometry"
if [[ -n "$session" ]]; then
  [[ "$session" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die "invalid session name: $session"
fi

readonly control_dir="${TMPDIR:-/tmp}/vnc-session-${UID}"
readonly control_path="${control_dir}/ssh-${session:-legacy}-%C"

if [[ "$action" == "status" ]]; then
  exec ssh -n "$ssh_host" '"$HOME/bin/vnc-get-display"' --status "$session"
fi
if [[ "$action" == "stop" ]]; then
  stop_args=(--stop)
  [[ "$force_stop" == "false" ]] || stop_args+=(--force)
  ssh -n "$ssh_host" '"$HOME/bin/vnc-get-display"' "${stop_args[@]}" "$session"
  ssh -n -S "$control_path" -O exit "$ssh_host" >/dev/null 2>&1 || true
  exit 0
fi

command -v cygstart >/dev/null 2>&1 || die "cygstart is not available"
[[ -e "$VNC_VIEWER" ]] || die "TigerVNC Viewer is missing: $VNC_VIEWER"

if [[ "$action" == "session" ]]; then
  display_output="$(ssh -n "$ssh_host" '"$HOME/bin/vnc-get-display"' --session "$session" "$geometry")"
else
  display_output="$(ssh -n "$ssh_host" '"$HOME/bin/vnc-get-display"' "$geometry")"
fi
display="$(
  printf '%s\n' "$display_output" |
    sed -n 's/^[[:space:]]*\([0-9][0-9]*\)[[:space:]]*$/\1/p' |
    tail -n 1
)"
[[ -n "$display" ]] || {
  printf 'Could not determine VNC display from %s.\n%s\n' "$ssh_host" "$display_output" >&2
  exit 1
}

remote_port=$((5900 + display))
viewer_host="$vnc_host"
viewer_port="$remote_port"

if [[ "$action" == "session" ]]; then
  local_port="${VNC_LOCAL_PORT:-$((16500 + display))}"
  [[ "$local_port" =~ ^[1-9][0-9]*$ ]] || die "invalid VNC_LOCAL_PORT: $local_port"
  (( remote_port <= 65535 && local_port <= 65535 )) || die "VNC port is too large"

  mkdir -p "$control_dir"
  chmod 700 "$control_dir"
  if ! ssh -n -S "$control_path" -O check "$ssh_host" >/dev/null 2>&1; then
    ssh -fNT -M -S "$control_path" \
      -o ExitOnForwardFailure=yes \
      -L "127.0.0.1:${local_port}:127.0.0.1:${remote_port}" \
      "$ssh_host"
  fi
  viewer_host="localhost"
  viewer_port="$local_port"
fi

printf 'connecting to %s:%s\n' "$viewer_host" "$viewer_port"
cygstart "$VNC_VIEWER" -passwd "$VNC_PASSWORD" -NoJpeg \
  -ShortcutModifiers=Ctrl,Alt "$viewer_host:$viewer_port"
