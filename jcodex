#!/bin/bash
set -euo pipefail

## load the JHPCE runtime and user-installed Codex
module load node
export PATH="$HOME/.local/bin:$PATH"

## install or upgrade only the user copy, never the module's Codex
codex_bin="$HOME/.local/bin/codex"
if [[ "${1:-}" == --update || ! -x "$codex_bin" ]] || [[ "$("$codex_bin" --help)" != *--no-daemon* ]]; then
  npm install --global --prefix "$HOME/.local" @openai/codex@latest
fi
[[ "$("$codex_bin" --help)" == *--no-daemon* ]] || {
  printf 'jcodex: user-installed Codex does not support --no-daemon: %s\n' "$codex_bin" >&2
  exit 1
}
if [[ "${1:-}" == --update ]]; then
  exec "$codex_bin" --version
fi

## recreate the node-local helper directory for the existing NFS workaround
codex_arg0_root="${CODEX_HOME:-$HOME/.codex}/tmp/arg0"
codex_arg0_local="/tmp/cody-codex-arg0-$(id -u)"
if [[ -L "$codex_arg0_root" && "$(readlink "$codex_arg0_root")" == "$codex_arg0_local" ]]; then
  if [[ ! -e "$codex_arg0_local" && ! -L "$codex_arg0_local" ]]; then
    (umask 077; mkdir -- "$codex_arg0_local")
  fi
  [[ -d "$codex_arg0_local" && ! -L "$codex_arg0_local" && -O "$codex_arg0_local" ]] || {
    printf 'jcodex: expected a private helper directory owned by this user: %s\n' "$codex_arg0_local" >&2
    exit 1
  }
  chmod 700 -- "$codex_arg0_local"
fi

## use the embedded CLI and forward all user arguments
exec "$codex_bin" --no-daemon --yolo "$@"
