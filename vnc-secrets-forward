#!/usr/bin/env python3
"""Forward Secret Service calls from a VNC desktop's private D-Bus to the user bus.

Each managed VNC desktop runs its own session bus so single-instance applications
stay on their own display. The user's one gnome-keyring-daemon lives on the
per-user bus, so this forwarder owns the keyring names on the private bus and
relays method calls, replies, errors, and keyring signals to that daemon.

The private bus starts it on demand through D-Bus activation (see vnc-session).
Before relaying a prompt it points the user bus activation environment at this
desktop, so unlock dialogs appear on the display that asked for them.
"""

import argparse
import os
import sys

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

FORWARDED_NAMES = ("org.freedesktop.secrets", "org.gnome.keyring")
SIGNAL_SENDER = "org.freedesktop.secrets"
PROMPT_INTERFACE = "org.freedesktop.Secret.Prompt"
## unlock dialogs wait for a person; never time out a relayed call first
RELAY_TIMEOUT_MS = 2**31 - 1
DO_NOT_QUEUE = 4
PRIMARY_OWNER = 1
ALREADY_OWNER = 4


def log(message):
    print(f"vnc-secrets-forward: {message}", file=sys.stderr, flush=True)


class Forwarder:
    def __init__(self, user_address, display, xauthority):
        self.loop = GLib.MainLoop()
        self.display = display
        self.xauthority = xauthority
        self.private = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.user = Gio.DBusConnection.new_for_address_sync(
            user_address,
            Gio.DBusConnectionFlags.AUTHENTICATION_CLIENT
            | Gio.DBusConnectionFlags.MESSAGE_BUS_CONNECTION,
            None,
            None,
        )
        ## forwarding into the bus it serves would loop forever
        if bus_id(self.private) == bus_id(self.user):
            raise RuntimeError("the private bus is the user bus; nothing to forward")
        self.unique_name = self.private.get_unique_name()
        self.owned = set()

    def own_names(self):
        for name in FORWARDED_NAMES:
            reply = self.private.call_sync(
                "org.freedesktop.DBus", "/org/freedesktop/DBus",
                "org.freedesktop.DBus", "RequestName",
                GLib.Variant("(su)", (name, DO_NOT_QUEUE)),
                GLib.VariantType("(u)"), Gio.DBusCallFlags.NONE, -1, None,
            )
            if reply.unpack()[0] in (PRIMARY_OWNER, ALREADY_OWNER):
                self.owned.add(name)
        if not self.owned:
            raise RuntimeError("another forwarder already owns the keyring names")

    def target_for(self, destination):
        if destination in self.owned:
            return destination
        if destination == self.unique_name:
            return SIGNAL_SENDER
        return None

    ## GDBus runs filters on its one worker thread, which also reads replies
    ## for every connection; a blocking call there deadlocks until the D-Bus
    ## timeout. The filter only queues; relaying happens on the main loop.
    def on_private_message(self, connection, message, incoming):
        if not incoming or message.get_message_type() != Gio.DBusMessageType.METHOD_CALL:
            return message
        target = self.target_for(message.get_destination())
        if target is None:
            return message
        GLib.idle_add(self.relay, message, target)
        return None

    def relay(self, message, target):
        if message.get_interface() == PROMPT_INTERFACE and message.get_member() == "Prompt":
            self.steer_prompts(lambda: self.forward(message, target))
        else:
            self.forward(message, target)
        return GLib.SOURCE_REMOVE

    ## the prompter must start on this display, so relay Prompt only after
    ## the user bus has its DISPLAY
    def steer_prompts(self, then):
        environment = {"DISPLAY": self.display}
        if self.xauthority:
            environment["XAUTHORITY"] = self.xauthority

        def on_updated(user_connection, result):
            try:
                user_connection.call_finish(result)
            except GLib.Error as error:
                log(f"could not point prompts at {self.display}: {error.message}")
            then()

        self.user.call(
            "org.freedesktop.DBus", "/org/freedesktop/DBus",
            "org.freedesktop.DBus", "UpdateActivationEnvironment",
            GLib.Variant("(a{ss})", (environment,)),
            None, Gio.DBusCallFlags.NONE, -1, None, on_updated,
        )

    def forward(self, message, target):
        relayed = Gio.DBusMessage.new_method_call(
            target, message.get_path(), message.get_interface(), message.get_member())
        body = message.get_body()
        if body is not None:
            relayed.set_body(body)
        if message.get_flags() & Gio.DBusMessageFlags.NO_REPLY_EXPECTED:
            relayed.set_flags(Gio.DBusMessageFlags.NO_REPLY_EXPECTED)
            self.user.send_message(relayed, Gio.DBusSendMessageFlags.NONE)
            return

        def on_reply(user_connection, result):
            try:
                reply = user_connection.send_message_with_reply_finish(result)
                if reply.get_message_type() == Gio.DBusMessageType.ERROR:
                    answer = Gio.DBusMessage.new_method_error_literal(
                        message, reply.get_error_name(), error_text(reply))
                else:
                    answer = Gio.DBusMessage.new_method_reply(message)
                    reply_body = reply.get_body()
                    if reply_body is not None:
                        answer.set_body(reply_body)
            except GLib.Error as error:
                answer = Gio.DBusMessage.new_method_error_literal(
                    message, "org.freedesktop.DBus.Error.ServiceUnknown",
                    f"user bus keyring unavailable: {error.message}")
            self.private.send_message(answer, Gio.DBusSendMessageFlags.NONE)

        self.user.send_message_with_reply(
            relayed, Gio.DBusSendMessageFlags.NONE, RELAY_TIMEOUT_MS, None, on_reply)

    def on_user_signal(self, connection, sender, path, interface, member, parameters):
        try:
            self.private.emit_signal(None, path, interface, member, parameters)
        except GLib.Error as error:
            log(f"could not relay {interface}.{member}: {error.message}")

    def on_closed(self, connection, remote_peer_vanished, error):
        self.loop.quit()

    def run(self):
        self.private.add_filter(self.on_private_message)
        self.user.signal_subscribe(
            SIGNAL_SENDER, None, None, None, None,
            Gio.DBusSignalFlags.NONE, self.on_user_signal)
        self.private.connect("closed", self.on_closed)
        self.user.connect("closed", self.on_closed)
        self.private.set_exit_on_close(False)
        self.user.set_exit_on_close(False)
        self.own_names()
        self.loop.run()


def bus_id(connection):
    return connection.call_sync(
        "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "GetId",
        None, GLib.VariantType("(s)"), Gio.DBusCallFlags.NONE, -1, None,
    ).unpack()[0]


def error_text(reply):
    body = reply.get_body()
    if body is not None and body.n_children() > 0 and body.get_child_value(0).is_of_type(
            GLib.VariantType("s")):
        return body.get_child_value(0).get_string()
    return reply.get_error_name()


def main():
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--display", default=os.environ.get("DISPLAY", ""),
                        help="display that keyring prompts should use")
    parser.add_argument("--user-bus", default=f"unix:path={runtime_dir}/bus",
                        help="address of the per-user bus that runs the keyring")
    args = parser.parse_args()
    if not args.display:
        parser.error("--display or DISPLAY is required")
    try:
        Forwarder(args.user_bus, args.display, os.environ.get("XAUTHORITY", "")).run()
    except (GLib.Error, RuntimeError) as error:
        log(str(getattr(error, "message", error)))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
