#!/usr/bin/env bash
set -euo pipefail

script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
script_dir="$(cd -- "$(dirname -- "$script_path")" && pwd -P)"
readonly script_dir
readonly bin_dir="${HOME}/bin"
readonly config_dir="${XDG_CONFIG_HOME:-${HOME}/.config}/vnc-session"
backup_tag="pre-gscripts-vnc-$(date +%Y%m%d-%H%M%S)"
readonly backup_tag
readonly -a commands=(
  vnc-get-display vnc-session vnc-self vnc-session-view vnc-host flameshot-vnc
)

usage() {
  printf '%s\n' \
    "Usage: install-vnc-tools [install|check]" \
    "Default action: install"
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

check_link() {
  local source="$1"
  local target="$2"

  [[ -L "$target" && "$(readlink -f -- "$target")" == "$source" ]]
}

preferred_jwm_source() {
  if [[ -r "${HOME}/.jwmrc-vnc" ]]; then
    printf '%s\n' "${HOME}/.jwmrc-vnc"
  elif [[ -r "${HOME}/.jwmrc" ]]; then
    printf '%s\n' "${HOME}/.jwmrc"
  else
    printf '%s\n' "${script_dir}/jwm-vnc-session.xml"
  fi
}

check_copy() {
  local source="$1"
  local target="$2"

  [[ -f "$target" && ! -L "$target" ]] && cmp -s -- "$source" "$target"
}

install_copy() {
  local source="$1"
  local target="$2"
  local backup temporary

  [[ -r "$source" ]] || die "configuration source is missing: $source"
  if check_copy "$source" "$target"; then
    printf 'Current copy %s <- %s\n' "$target" "$source"
    return
  fi
  if [[ -e "$target" && ! -L "$target" ]]; then
    backup="${target}.${backup_tag}"
    mv -- "$target" "$backup"
    printf 'Backed up %s to %s\n' "$target" "$backup"
  fi

  ## replace a prior symlink atomically without modifying its source
  temporary="$(mktemp "${config_dir}/.jwm.xml.XXXXXX")"
  install -m 600 -- "$source" "$temporary"
  mv -Tf -- "$temporary" "$target"
  printf 'Copied %s <- %s\n' "$target" "$source"
}

install_link() {
  local source="$1"
  local target="$2"
  local backup

  [[ -e "$source" ]] || die "canonical source is missing: $source"
  if [[ -e "$target" && ! -L "$target" ]]; then
    backup="${target}.${backup_tag}"
    mv -- "$target" "$backup"
    printf 'Backed up %s to %s\n' "$target" "$backup"
  fi
  ln -sfn -- "$source" "$target"
  printf 'Linked %s -> %s\n' "$target" "$source"
}

action="${1:-install}"
[[ $# -le 1 ]] || { usage >&2; exit 1; }
case "$action" in
  install)
    install -d -m 700 "$bin_dir" "$config_dir"
    for command_name in "${commands[@]}"; do
      install_link "${script_dir}/${command_name}" "${bin_dir}/${command_name}"
    done
    jwm_source="$(preferred_jwm_source)"
    install_copy "$jwm_source" "${config_dir}/jwm.xml"
    "${bin_dir}/vnc-session" doctor
    ;;
  check)
    failed=0
    for command_name in "${commands[@]}"; do
      source="${script_dir}/${command_name}"
      target="${bin_dir}/${command_name}"
      if ! check_link "$source" "$target"; then
        printf 'MISMATCH %s (expected %s)\n' "$target" "$source" >&2
        failed=1
      fi
    done
    source="$(preferred_jwm_source)"
    target="${config_dir}/jwm.xml"
    if ! check_copy "$source" "$target"; then
      printf 'MISMATCH %s (expected a copy of %s)\n' "$target" "$source" >&2
      failed=1
    fi
    (( failed == 0 )) || exit 1
    "${bin_dir}/vnc-session" doctor
    printf 'VNC tool links: OK\n'
    ;;
  --help|-h)
    usage
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
