#!/usr/bin/env bash
set -euo pipefail

script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
script_dir="$(cd -- "$(dirname -- "$script_path")" && pwd -P)"
readonly script_dir
readonly bin_dir="${HOME}/bin"
## obsolete: VNC desktops now read ~/.jwmrc-vnc directly
readonly legacy_jwm_copy="${XDG_CONFIG_HOME:-${HOME}/.config}/vnc-session/jwm.xml"
## shared with install-vnc-bru.sh, which exports VNC_BRU_BACKUP_DIR per run
backup_dir="${VNC_BRU_BACKUP_DIR:-${XDG_STATE_HOME:-${HOME}/.local/state}/vnc-bru-setup/backups/$(date +%Y%m%d-%H%M%S)-$$}"
readonly backup_dir
readonly -a commands=(
  vnc-get-display vnc-session vnc-self vnc-session-view vnc-host flameshot-vnc
)
dry_run=false

usage() {
  printf '%s\n' \
    "Usage: install-vnc-tools [install [--dry-run]|check]" \
    "Default action: install" \
    "" \
    "install --dry-run  list what would change; change nothing" \
    "Replaced files are first moved or copied to" \
    "  \${VNC_BRU_BACKUP_DIR:-~/.local/state/vnc-bru-setup/backups/<run>}/<absolute path>" \
    "and listed in the MANIFEST file there."
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

check_link() {
  local source="$1"
  local target="$2"

  [[ -L "$target" && "$(readlink -f -- "$target")" == "$source" ]]
}

## a running desktop may still read the old copy on a JWM restart, so it is
## reported and left in place
note_legacy_jwm_copy() {
  if [[ -e "$legacy_jwm_copy" ]]; then
    printf 'NOTE: %s is no longer used; VNC desktops read ~/.jwmrc-vnc. Remove it after restarting desktops started before this change.\n' "$legacy_jwm_copy"
  fi
}

## move or copy TARGET into the backup tree and record it in MANIFEST
backup_target() {
  local mode="$1"
  local target="$2"
  local destination="${backup_dir}${target}"

  install -d -m 700 "$(dirname -- "$destination")"
  [[ ! -e "$destination" ]] || destination="${destination}.$(date +%s%N)"
  if [[ "$mode" == move ]]; then
    mv -- "$target" "$destination"
  else
    cp -a -- "$target" "$destination"
  fi
  printf '%s\t%s\n' "$target" "$destination" >> "${backup_dir}/MANIFEST"
  printf '>>> BACKUP: %s saved as %s\n' "$target" "$destination"
}

install_link() {
  local source="$1"
  local target="$2"
  local previous=""

  [[ -e "$source" ]] || die "canonical source is missing: $source"
  if check_link "$source" "$target"; then
    printf 'Current link %s -> %s\n' "$target" "$source"
    return
  fi
  if [[ -L "$target" ]]; then
    previous="$(readlink -- "$target")"
  fi
  if [[ "$dry_run" == true ]]; then
    if [[ -n "$previous" ]]; then
      printf 'Would relink %s -> %s (now -> %s)\n' "$target" "$source" "$previous"
    elif [[ -e "$target" ]]; then
      printf 'Would replace %s with a link to %s (file backed up)\n' "$target" "$source"
    else
      printf 'Would link %s -> %s\n' "$target" "$source"
    fi
    return
  fi
  if [[ -e "$target" && ! -L "$target" ]]; then
    backup_target move "$target"
  fi
  ln -sfn -- "$source" "$target"
  if [[ -n "$previous" ]]; then
    printf '>>> CHANGED: relinked %s -> %s (was -> %s)\n' "$target" "$source" "$previous"
  else
    printf '>>> CHANGED: linked %s -> %s\n' "$target" "$source"
  fi
}

action="${1:-install}"
if [[ $# -eq 2 && "$action" == install && "$2" == --dry-run ]]; then
  dry_run=true
elif [[ $# -gt 1 ]]; then
  usage >&2
  exit 1
fi
case "$action" in
  install)
    if [[ "$dry_run" != true ]]; then
      install -d -m 700 "$bin_dir"
    fi
    for command_name in "${commands[@]}"; do
      install_link "${script_dir}/${command_name}" "${bin_dir}/${command_name}"
    done
    note_legacy_jwm_copy
    ## doctor only reads host state
    "${script_dir}/vnc-session" doctor
    ;;
  check)
    failed=0
    for command_name in "${commands[@]}"; do
      source="${script_dir}/${command_name}"
      target="${bin_dir}/${command_name}"
      if ! check_link "$source" "$target"; then
        printf 'MISMATCH %s (expected %s)\n' "$target" "$source" >&2
        failed=1
      fi
    done
    (( failed == 0 )) || exit 1
    note_legacy_jwm_copy
    "${bin_dir}/vnc-session" doctor
    printf 'VNC tool links: OK\n'
    ;;
  --help|-h)
    usage
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
