#!/usr/bin/env bash
set -euo pipefail

readonly default_geometry="1820x960"
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly script_dir
readonly vnc_session="${script_dir}/vnc-session"

if [[ ! -x "$vnc_session" ]]; then
  printf 'error: required helper is missing or not executable: %s\n' "$vnc_session" >&2
  exit 1
fi

usage() {
  printf '%s\n' \
    "Usage:" \
    "  vnc-get-display [GEOMETRY]" \
    "  vnc-get-display --list" \
    "  vnc-get-display --session NAME [GEOMETRY]" \
    "  vnc-get-display --status NAME|:DISPLAY" \
    "  vnc-get-display --stop [--force] NAME|:DISPLAY"
}

case "${1:-}" in
  --list)
    [[ $# -eq 1 ]] || { usage >&2; exit 1; }
    exec "$vnc_session" list
    ;;
  --session)
    [[ $# -ge 2 && $# -le 3 ]] || { usage >&2; exit 1; }
    name="$2"
    geometry="${3:-$default_geometry}"
    "$vnc_session" start "$name" "" "$geometry" >&2
    exec "$vnc_session" display "$name"
    ;;
  --status)
    [[ $# -eq 2 ]] || { usage >&2; exit 1; }
    exec "$vnc_session" status "$2"
    ;;
  --stop)
    shift
    if [[ "${1:-}" == "--force" ]]; then
      [[ $# -eq 2 ]] || { usage >&2; exit 1; }
      exec "$vnc_session" stop --force "$2"
    fi
    [[ $# -eq 1 ]] || { usage >&2; exit 1; }
    exec "$vnc_session" stop "$1"
    ;;
  --help|-h)
    usage
    exit 0
    ;;
esac

## preserve the scalar legacy interface used by vnc-HOST viewer scripts
geometry="${1:-$default_geometry}"
[[ "$geometry" =~ ^[1-9][0-9]*x[1-9][0-9]*$ ]] || {
  printf 'error: geometry must look like 1820x960\n' >&2
  exit 1
}

## legacy default is always direct-LAN display :1, never another named session
exec "$vnc_session" ensure --direct :1 "$geometry"
