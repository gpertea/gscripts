#!/usr/bin/env bash
set -euo pipefail

program="$(basename -- "$0")"
case "${OSTYPE:-$(uname -s)}" in
  msys*|cygwin*|MINGW*|MSYS*|CYGWIN*) default_transport="--direct" ;;
  *) default_transport="--tunnel" ;;
esac
transport="${VNC_HOST_DEFAULT_TRANSPORT:-$default_transport}"
transport_explicit="${VNC_HOST_DEFAULT_TRANSPORT:+true}"
force_restart=""
force_stop=""
action=""

usage() {
  printf '%s\n' \
    "Usage:" \
    "  vnc-host [--direct|--tunnel] [--force-restart] HOST[:DISPLAY|:NAME]" \
    "  vnc-HOST [--direct|--tunnel] [--force-restart] [DISPLAY|NAME]" \
    "  vnc-HOST-USER [--direct|--tunnel] [--force-restart] [DISPLAY|NAME]" \
    "  vnc-host -l|--list HOST" \
    "  vnc-HOST -l|--list" \
    "  vnc-HOST --status [DISPLAY|NAME]" \
    "  vnc-HOST --stop [--force] [DISPLAY|NAME]" \
    "Host-only default: ${default_transport}, display :1; user-specific default: --tunnel, session self" \
    "The final alias token is USER; use vnc-host HOST for a literal hyphenated hostname." \
    "VNC_HOST_ALIAS and VNC_HOST_DEFAULT_TRANSPORT override alias and transport defaults."
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

while [[ "${1:-}" == -* ]]; do
  case "$1" in
    --direct|--tunnel) transport="$1"; transport_explicit=true ;;
    --force-restart) force_restart="$1" ;;
    --force) force_stop="$1" ;;
    --status|--stop) action="$1" ;;
    -l|--list) action="--list" ;;
    --help|-h) usage; exit 0 ;;
    *) die "unknown option: $1" ;;
  esac
  shift
done

if [[ "$program" == "vnc-host" && -z "${VNC_HOST_ALIAS:-}" ]]; then
  [[ $# -eq 1 ]] || { usage >&2; exit 1; }
  target="$1"
  [[ "$target" != *@* || "$target" == *:* ]] || target="${target}:self"
else
  host="${VNC_HOST_ALIAS:-${program#vnc-}}"
  [[ -n "$host" && ( -n "${VNC_HOST_ALIAS:-}" || "$host" != "$program" ) ]] || die "cannot derive host from $program"
  if [[ -z "${VNC_HOST_ALIAS:-}" && "$host" == *-* ]]; then
    ## the final token selects the account; earlier hyphens belong to the host
    remote_user="${host##*-}"
    host="${host%-*}"
    [[ "$host" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ &&
       "$remote_user" =~ ^[A-Za-z0-9_][A-Za-z0-9_.]*$ ]] || die "invalid host/user alias: $program"
    host="${remote_user}@${host}"
  fi
  [[ $# -le 1 ]] || { usage >&2; exit 1; }
  default_suffix=1
  [[ "$host" != *@* ]] || default_suffix=self
  suffix="${1:-$default_suffix}"
  suffix="${suffix#:}"
  target="${host}:${suffix}"
fi

## user desktops have their own display assignment and stay behind SSH by default
if [[ "${target%%:*}" == *@* && "$transport_explicit" != true ]]; then
  transport=--tunnel
fi

case "$transport" in
  --direct|--tunnel) ;;
  *) die "invalid VNC_HOST_DEFAULT_TRANSPORT: $transport" ;;
esac

script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
script_dir="$(cd -- "$(dirname -- "$script_path")" && pwd -P)"
case "${OSTYPE:-$(uname -s)}" in
  msys*|cygwin*|MINGW*|MSYS*|CYGWIN*) viewer_helper="${script_dir}/vnc-win-lan" ;;
  *) viewer_helper="${script_dir}/vnc-session-view" ;;
esac
[[ -x "$viewer_helper" ]] || die "viewer helper is missing or not executable: $viewer_helper"

if [[ -n "$action" ]]; then
  [[ -z "$force_restart" ]] || die "--force-restart is not valid with $action"
  [[ "$action" == "--stop" || -z "$force_stop" ]] || die "--force is only valid with --stop"
  args=("$action")
  [[ -z "$force_stop" ]] || args+=("$force_stop")
  exec "$viewer_helper" "${args[@]}" "$target"
fi

[[ -z "$force_stop" ]] || die "--force is only valid with --stop"

args=("$transport")
[[ -z "$force_restart" ]] || args+=("$force_restart")

exec "$viewer_helper" "${args[@]}" "$target"
