#!/bin/bash
set -euo pipefail

is_windows_msys=false
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*) is_windows_msys=true ;;
esac

windows_codex_bin() {
  local local_app_data="${LOCALAPPDATA:-}"

  if [[ -z "$local_app_data" ]] && command -v powershell.exe >/dev/null 2>&1; then
    local_app_data="$(powershell.exe -NoLogo -NoProfile -Command \
      '[Environment]::GetFolderPath("LocalApplicationData")' | tr -d '\r')"
  fi
  if [[ -n "$local_app_data" ]] && command -v cygpath >/dev/null 2>&1; then
    local_app_data="$(cygpath -u "$local_app_data")"
  fi

  [[ -n "$local_app_data" ]] || return 1
  printf '%s/Programs/OpenAI/Codex/bin/codex.exe\n' "$local_app_data"
}

resolve_codex_bin() {
  local candidate

  if $is_windows_msys; then
    candidate="$(windows_codex_bin || true)"
    if [[ -n "$candidate" && -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  fi

  command -v codex
}

## if on JHPCE, load the npm module
if [[ $HOSTNAME == compute-* || $HOSTNAME == transfer-* ]]; then
  module load node
  export PATH=$HOME/.local/bin:$PATH
fi

## Keep colors enabled for Codex UI, even if parent env exports NO_COLOR.
unset NO_COLOR
export FORCE_COLOR=1
export CLICOLOR_FORCE=1

## Prefer 256-color TERM values when available.
if [[ -n "${TMUX:-}" ]]; then
  if infocmp tmux-256color >/dev/null 2>&1; then
    export TERM=tmux-256color
  fi
elif [[ "${TERM:-}" == "rxvt-unicode" ]]; then
  if infocmp rxvt-unicode-256color >/dev/null 2>&1; then
    export TERM=rxvt-unicode-256color
  fi
fi
export COLORTERM=truecolor

## Update only when explicitly requested; normal launches do no network work.
if [[ "${1:-}" == "--update" ]]; then
  printf 'Updating Codex CLI...\n'
  if $is_windows_msys; then
    if ! command -v powershell.exe >/dev/null 2>&1; then
      printf 'cody: powershell.exe is required to update Codex on Windows\n' >&2
      exit 127
    fi

    # Use the native Windows standalone installer. Prepending System32 keeps
    # MSYS2 tar.exe from receiving Windows paths from the PowerShell installer.
    powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command \
      '$ErrorActionPreference = "Stop"; $env:Path = "$env:SystemRoot\System32;$env:Path"; $env:CODEX_NON_INTERACTIVE = "1"; Invoke-RestMethod "https://chatgpt.com/codex/install.ps1" | Invoke-Expression'
  else
    if ! command -v npm >/dev/null 2>&1; then
      printf 'cody: npm is required to update Codex\n' >&2
      exit 127
    fi
    npm install --global @openai/codex@latest
  fi
  hash -r

  codex_bin="$(resolve_codex_bin || true)"
  if [[ -z "$codex_bin" ]]; then
    printf 'cody: Codex was updated but is not available on PATH\n' >&2
    exit 127
  fi

  "$codex_bin" --version
  exit 0
fi

## Resolve once and replace the wrapper with Codex for correct signal handling.
codex_bin="$(resolve_codex_bin || true)"
if [[ -z "$codex_bin" ]]; then
  printf 'cody: codex is not available on PATH\n' >&2
  exit 127
fi

## opt into the OpenAI documentation MCP for this launch only
declare -a codex_args=(--yolo)
if [[ "${1:-}" == "--docs" ]]; then
  codex_args+=(-c 'mcp_servers.openaiDeveloperDocs.enabled=true')
  shift
fi

exec "$codex_bin" "${codex_args[@]}" "$@"
