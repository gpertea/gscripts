#!/bin/bash
set -euo pipefail

is_windows_msys=false
is_linux=false
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*) is_windows_msys=true ;;
  Linux) is_linux=true ;;
esac

# Codex's built-in updater inherits this environment. Its Windows installer
# passes Windows paths to tar, so prefer native Windows tools in this process
# and its children. The invoking MSYS2 shell keeps its original environment.
if $is_windows_msys; then
  windows_system32="$(cygpath -u "${SystemRoot:-${SYSTEMROOT:-C:\\Windows}}")/System32"
  export PATH="$windows_system32:$windows_system32/WindowsPowerShell/v1.0:$PATH"
  # Windows PowerShell must discover its own modules, not PowerShell 7's.
  unset PSModulePath
fi

windows_codex_bin() {
  local local_app_data="${LOCALAPPDATA:-}"

  if [[ -z "$local_app_data" ]] && command -v powershell.exe >/dev/null 2>&1; then
    local_app_data="$(powershell.exe -NoLogo -NoProfile -Command \
      '[Environment]::GetFolderPath("LocalApplicationData")' | tr -d '\r')"
  fi
  if [[ -n "$local_app_data" ]] && command -v cygpath >/dev/null 2>&1; then
    local_app_data="$(cygpath -u "$local_app_data")"
  fi

  [[ -n "$local_app_data" ]] || return 1
  printf '%s/Programs/OpenAI/Codex/bin/codex.exe\n' "$local_app_data"
}

resolve_codex_bin() {
  local candidate

  if $is_windows_msys; then
    candidate="$(windows_codex_bin || true)"
    if [[ -n "$candidate" && -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  fi

  command -v codex
}

socket_is_listening() {
  local socket_path="$1"

  ss -xlH | awk -v path="$socket_path" \
    '$5 == path { found = 1 } END { exit !found }'
}

ensure_display_app_server() {
  local display_number="$1" lock_fd server_pid
  local runtime_root state_dir socket_path lock_path log_path pid_path

  ## preserve the VNC session environment and pin browser MCPs to it
  export XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"
  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}"
  export LIN_BROWSER_USE_AUTH_DISPLAY=":${display_number}"

  command -v flock >/dev/null 2>&1 || {
    printf 'cody: flock is required for display-specific app-server startup\n' >&2
    exit 127
  }
  command -v ss >/dev/null 2>&1 || {
    printf 'cody: ss is required for display-specific app-server startup\n' >&2
    exit 127
  }

  runtime_root="${XDG_RUNTIME_DIR}/cody"
  state_dir="${runtime_root}/display-${display_number}"
  socket_path="${state_dir}/app-server.sock"
  lock_path="${state_dir}/startup.lock"
  log_path="${state_dir}/app-server.log"
  pid_path="${state_dir}/app-server.pid"
  install -d -m 700 -- "$runtime_root" "$state_dir"

  ## serialize concurrent cody launches on this display
  exec {lock_fd}>"$lock_path"
  flock "$lock_fd"
  if ! socket_is_listening "$socket_path"; then
    rm -f -- "$socket_path"
    nohup "$codex_bin" app-server --listen "unix://${socket_path}" \
      </dev/null >>"$log_path" 2>&1 &
    server_pid=$!
    printf '%s\n' "$server_pid" > "$pid_path"

    ## wait briefly for the server to bind or report an early failure
    for _ in {1..100}; do
      socket_is_listening "$socket_path" && break
      if ! kill -0 "$server_pid" 2>/dev/null; then
        printf 'cody: app-server for DISPLAY=%s exited; see %s\n' \
          "$DISPLAY" "$log_path" >&2
        exit 1
      fi
      sleep 0.05
    done
    if ! socket_is_listening "$socket_path"; then
      printf 'cody: app-server for DISPLAY=%s did not become ready; see %s\n' \
        "$DISPLAY" "$log_path" >&2
      exit 1
    fi
  fi
  flock -u "$lock_fd"
  exec {lock_fd}>&-

  cody_app_server="unix://${socket_path}"
}

## if on JHPCE, load the npm module
if [[ $HOSTNAME == compute-* || $HOSTNAME == transfer-* ]]; then
  module load node
  export PATH=$HOME/.local/bin:$PATH
fi

## Keep colors enabled for Codex UI, even if parent env exports NO_COLOR.
unset NO_COLOR
export FORCE_COLOR=1
export CLICOLOR_FORCE=1

## Prefer 256-color TERM values when available.
if [[ -n "${TMUX:-}" ]]; then
  if infocmp tmux-256color >/dev/null 2>&1; then
    export TERM=tmux-256color
  fi
elif [[ "${TERM:-}" == "rxvt-unicode" ]]; then
  if infocmp rxvt-unicode-256color >/dev/null 2>&1; then
    export TERM=rxvt-unicode-256color
  fi
fi
export COLORTERM=truecolor

## Update only when explicitly requested; normal launches do no network work.
if [[ "${1:-}" == "--update" ]]; then
  printf 'Updating Codex CLI...\n'
  if $is_windows_msys; then
    if ! command -v powershell.exe >/dev/null 2>&1; then
      printf 'cody: powershell.exe is required to update Codex on Windows\n' >&2
      exit 127
    fi

    # Use the same Windows environment as Codex's built-in updater.
    powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command \
      '$ErrorActionPreference = "Stop"; $env:CODEX_NON_INTERACTIVE = "1"; Invoke-RestMethod "https://chatgpt.com/codex/install.ps1" | Invoke-Expression'
  else
    if ! command -v npm >/dev/null 2>&1; then
      printf 'cody: npm is required to update Codex\n' >&2
      exit 127
    fi
    npm install --global @openai/codex@latest
  fi
  hash -r

  codex_bin="$(resolve_codex_bin || true)"
  if [[ -z "$codex_bin" ]]; then
    printf 'cody: Codex was updated but is not available on PATH\n' >&2
    exit 127
  fi

  "$codex_bin" --version
  exit 0
fi

## Resolve once and replace the wrapper with Codex for correct signal handling.
codex_bin="$(resolve_codex_bin || true)"
if [[ -z "$codex_bin" ]]; then
  printf 'cody: codex is not available on PATH\n' >&2
  exit 127
fi

## opt into the OpenAI documentation MCP for this launch only
declare -a codex_args=(--yolo)
if [[ "${1:-}" == "--docs" ]]; then
  codex_args+=(-c 'mcp_servers.openaiDeveloperDocs.enabled=true')
  shift
fi

## Linux VNC/GUI sessions share one app-server per numeric display.
cody_app_server=""
if $is_linux && [[ "${DISPLAY:-}" =~ ^:([0-9]+)(\.[0-9]+)?$ ]]; then
  ensure_display_app_server "${BASH_REMATCH[1]}"
  codex_args+=(--remote "$cody_app_server")
fi

exec "$codex_bin" "${codex_args[@]}" "$@"
