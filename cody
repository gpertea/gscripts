#!/bin/bash
set -euo pipefail
## if on JHPCE, load the npm module
if [[ $HOSTNAME == compute-* || $HOSTNAME == transfer-* ]]; then
  echo "Using JHPCE 'node' module with separate codex installation"
  module load node
  export NPM_CONFIG_PREFIX="$HOME/.local"
  export PATH=$HOME/.local/bin:$PATH
  hash -r
  wcodex=$(which codex)
  echo "codex is run from: $wcodex"
fi

# Keep colors enabled for Codex UI, even if parent env exports NO_COLOR.
unset NO_COLOR
export FORCE_COLOR=1
export CLICOLOR_FORCE=1

# Prefer 256-color TERM values when available.
if [[ -n "${TMUX:-}" ]]; then
  if infocmp tmux-256color >/dev/null 2>&1; then
    export TERM=tmux-256color
  fi
elif [[ "${TERM:-}" == "rxvt-unicode" ]]; then
  if infocmp rxvt-unicode-256color >/dev/null 2>&1; then
    export TERM=rxvt-unicode-256color
  fi
fi
export COLORTERM=truecolor
# Keep automatic updates, but don't block startup on transient npm/network issues.
if command -v npm >/dev/null 2>&1; then
  codex_pkg_parent="$HOME/.local/lib/node_modules/@openai"
  ## remove npm staging leftovers for codex only
  if [[ -d "$codex_pkg_parent" ]]; then
    find "$codex_pkg_parent" -maxdepth 1 -type d -name '.codex-*' -exec rm -rf {} +
  fi
  npm i -g --prefix "$HOME/.local" @openai/codex >/dev/null 2>&1 || true
fi

exec "$HOME/.local/bin/codex" --yolo "$@"
