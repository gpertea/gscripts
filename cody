#!/bin/bash
set -euo pipefail

is_windows_msys=false
is_linux=false
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*) is_windows_msys=true ;;
  Linux) is_linux=true ;;
esac

## resolve native PowerShell without putting Windows tools ahead of MSYS2 tools
## in agent command shells. The installer receives its own Windows-first PATH.
if $is_windows_msys; then
  windows_system32="$(cygpath -u "${SystemRoot:-${SYSTEMROOT:-C:\\Windows}}")/System32"
  windows_powershell="$windows_system32/WindowsPowerShell/v1.0/powershell.exe"
fi

windows_codex_bin() {
  local local_app_data="${LOCALAPPDATA:-}"

  if [[ -z "$local_app_data" && -x "$windows_powershell" ]]; then
    local_app_data="$(env -u PSModulePath "$windows_powershell" -NoLogo -NoProfile -Command \
      '[Environment]::GetFolderPath("LocalApplicationData")' | tr -d '\r')"
  fi
  if [[ -n "$local_app_data" ]] && command -v cygpath >/dev/null 2>&1; then
    local_app_data="$(cygpath -u "$local_app_data")"
  fi

  [[ -n "$local_app_data" ]] || return 1
  printf '%s/Programs/OpenAI/Codex/bin/codex.exe\n' "$local_app_data"
}

resolve_codex_bin() {
  local candidate

  if $is_windows_msys; then
    candidate="$(windows_codex_bin || true)"
    if [[ -n "$candidate" && -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  fi

  command -v codex
}

## if on JHPCE, load the npm module
if [[ $HOSTNAME == compute-* || $HOSTNAME == transfer-* ]]; then
  module load node
  export PATH=$HOME/.local/bin:$PATH

  ## recreate the node-local helper directory when home has the NFS workaround
  codex_arg0_root="${CODEX_HOME:-$HOME/.codex}/tmp/arg0"
  codex_arg0_local="/tmp/cody-codex-arg0-$(id -u)"
  if [[ -L "$codex_arg0_root" && "$(readlink "$codex_arg0_root")" == "$codex_arg0_local" ]]; then
    if [[ ! -e "$codex_arg0_local" && ! -L "$codex_arg0_local" ]]; then
      (umask 077; mkdir -- "$codex_arg0_local")
    fi
    [[ -d "$codex_arg0_local" && ! -L "$codex_arg0_local" && -O "$codex_arg0_local" ]] || {
      printf 'cody: expected a private helper directory owned by this user: %s\n' "$codex_arg0_local" >&2
      exit 1
    }
    chmod 700 -- "$codex_arg0_local"
  fi
fi

## direct sessions inherit their terminal display; supply browser-tool defaults only
if $is_linux && [[ "${DISPLAY:-}" =~ ^:([0-9]+)(\.[0-9]+)?$ ]]; then
  export XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"
  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}"
  export LIN_BROWSER_USE_AUTH_DISPLAY="${LIN_BROWSER_USE_AUTH_DISPLAY:-:${BASH_REMATCH[1]}}"
fi

confirm() {
  local answer
  read -r -p "$1 [y/N] " answer || return 1
  [[ "$answer" == [yY] || "$answer" == [yY][eE][sS] ]]
}

codex_version() {
  "$codex_bin" --version | awk '{print $NF}'
}

update_codex() {
  local installed_version
  printf 'Updating Codex CLI...\n'
  if $is_windows_msys; then
    if [[ ! -x "$windows_powershell" ]]; then
      printf 'cody: powershell.exe is required to update Codex on Windows\n' >&2
      exit 127
    fi

    ## the Windows installer requires native tar and PowerShell 5.1 modules.
    env -u PSModulePath PATH="$windows_system32:$windows_system32/WindowsPowerShell/v1.0:$PATH" \
      "$windows_powershell" -NoLogo -NoProfile -ExecutionPolicy Bypass -Command \
      '$ErrorActionPreference = "Stop"; $env:CODEX_NON_INTERACTIVE = "1"; Invoke-RestMethod "https://chatgpt.com/codex/install.ps1" | Invoke-Expression' || return "$?"
  else
    if ! command -v npm >/dev/null 2>&1; then
      printf 'cody: npm is required to update Codex\n' >&2
      exit 127
    fi
    npm install --global @openai/codex@latest || return "$?"
  fi
  hash -r

  codex_bin="$(resolve_codex_bin || true)"
  if [[ -z "$codex_bin" ]]; then
    printf 'cody: Codex was updated but is not available on PATH\n' >&2
    exit 127
  fi

  installed_version="$(codex_version)" || return "$?"
  printf 'Installed CLI: %s (%s)\n' "$installed_version" "$codex_bin"
}

newer_version() {
  local -a latest_parts installed_parts
  local index
  ## compare stable release numbers without downgrading a newer local CLI
  [[ "$1" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && "$2" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  IFS=. read -r -a latest_parts <<< "$1"
  IFS=. read -r -a installed_parts <<< "$2"
  for index in 0 1 2; do
    ((10#${latest_parts[index]} <= 10#${installed_parts[index]})) || return 0
    ((10#${latest_parts[index]} >= 10#${installed_parts[index]})) || return 1
  done
  return 1
}

skip_update=false
update_only=false
use_docs=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --noupdate) skip_update=true ;;
    --update) update_only=true ;;
    --docs) use_docs=true ;;
    *) break ;;
  esac
  shift
done
if $skip_update && $update_only; then
  printf 'cody: --noupdate and --update cannot be combined\n' >&2
  exit 2
fi

## distinguish interactive sessions from administrative subcommands
interactive=true
skip_value=false
command_seen=false
has_no_daemon=false
for arg in "$@"; do
  if $skip_value; then skip_value=false; continue; fi
  case "$arg" in
    --) break ;;
    --remote|--remote=*|--remote-auth-token-env|--remote-auth-token-env=*|--attach|--attach=*|--server-status|--server-stop|--server-endpoint)
      printf 'cody: remote/display-server options are retired; sessions use --no-daemon\n' >&2
      exit 2 ;;
    -c|--config|--enable|--disable|-m|--model|-i|--image|-C|--cd|-p|--profile|-s|--sandbox|-a|--ask-for-approval|--add-dir|--local-provider)
      skip_value=true ;;
    --no-daemon) has_no_daemon=true ;;
    --help|-h|--version|-V)
      interactive=false ;;
    -*) ;;
    *)
      if $command_seen; then continue; fi
      command_seen=true
      case "$arg" in
        resume|fork) ;;
        exec|e|review|login|logout|mcp|plugin|app-server|remote-control|completion|update|doctor|sandbox|debug|apply|cloud|exec-server|features|help|agents|queue|archive|a|delete|unarchive|migrate-rollouts|migrate-nfs-db)
          interactive=false ;;
      esac
      ;;
  esac
done

## resolve the CLI again after any update, then exec for signal handling
codex_bin="$(resolve_codex_bin || true)"
if $update_only; then
  update_codex
  exit 0
fi
if [[ -z "$codex_bin" ]]; then
  printf 'cody: codex is not available on PATH\n' >&2
  exit 127
fi

checked_updates=false
if $interactive && ! $skip_update && [[ -t 0 && -t 1 && "${1:-}" != --help && "${1:-}" != --version ]]; then
  latest_version=''
  if $is_windows_msys && [[ -x "$windows_powershell" ]]; then
    checked_updates=true
    latest_version="$(env -u PSModulePath "$windows_powershell" -NoLogo -NoProfile -Command \
      '$ErrorActionPreference = "Stop"; (Invoke-RestMethod -TimeoutSec 5 "https://registry.npmjs.org/@openai%2fcodex/latest").version' 2>/dev/null | tr -d '\r')" || true
  elif command -v npm >/dev/null 2>&1; then
    checked_updates=true
    ## bound offline delays; failure leaves the installed CLI available
    latest_version="$(npm view @openai/codex version --fetch-retries=0 --fetch-timeout=5000 2>/dev/null)" || true
  fi
  if $checked_updates; then
    installed_version="$(codex_version)"
    if [[ -z "$latest_version" ]]; then
      printf 'cody: update check unavailable; launching installed CLI %s\n' "$installed_version" >&2
    elif newer_version "$latest_version" "$installed_version"; then
      printf 'Codex update available: %s -> %s\n' "$installed_version" "$latest_version"
      if confirm 'Update before opening Codex?'; then
        update_codex
      fi
    fi
  fi
fi

declare -a codex_args=(--yolo)
if $interactive && ! $has_no_daemon; then
  codex_args+=(--no-daemon)
fi
if $is_windows_msys; then
  ## expose direct MSYS2 Bash selection without changing desktop settings.
  codex_args+=(--no-alt-screen -c 'features.unified_exec=true' -c 'allow_login_shell=false'
    -c 'tui.keymap.chat.prompt_stack_back=["f10","alt-down"]')
  ## mintty supports truecolor; avoid a native Windows TTY detection downgrade.
  ## preserve explicit color settings and leave redirected output alone.
  if [[ ${TERM_PROGRAM:-} == mintty && -t 1 && -z ${NO_COLOR+x} && -z ${FORCE_COLOR+x} ]]; then
    export FORCE_COLOR=3
  fi
fi
if $skip_update || $checked_updates; then
  ## cody owns this launch's update prompt; --noupdate disables both checks
  codex_args+=(-c 'check_for_update_on_startup=false')
fi
if $use_docs; then
  codex_args+=(-c 'mcp_servers.openaiDeveloperDocs.enabled=true')
fi

## exec directly so cwd, environment, exit status, and signals belong to this client
exec "$codex_bin" "${codex_args[@]}" "$@"
